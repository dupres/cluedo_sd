{% extends 'base.html.twig'%}

{% block body %}

    <h1>Connexion</h1>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="{{ path('app_login') }}" method="post">
        <table>
            <tr>
                <td><label for="email">Email :</label></td>
                <td><input type="text" id="email" name="_email" value="{{ last_username }}" autocomplete="email" required autofocus></td>
            </tr>
            <tr>
                <td><label for="password">Mot de passe :</label></td>
                <td>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                </td>
            </tr>

            <tr title='Permet de rester connecté sur le site même après la fermeture du navigateur.'>
                <td><label for="remember_me">Rester connecté</label></td>
                <td><input type="checkbox" id="remember_me" name="_remember_me" checked></td>
            </tr>
            

            <tr><td colspan='2'><button type='submit'>Se connecter</button></td></tr>
        </table>
    </form>
    <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    <p><a href="{{ path('app_home') }}">Retourner à l'accueil</a></p>
    
