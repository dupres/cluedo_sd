{% extends 'base.html.twig' %}

{% block title %}Liste des cartes{% endblock %}

{% block body %}
    <h1>Liste des cartes</h1>

    <form method="get" action="" id="cards_table_filters"></form>
    <table id='cards_table'>
        <thead>
            <tr id='cards_table_filters_tr'>
                <th colspan="1">
                    <input form='cards_table_filters' type="text" id="name" name="name" class="form-control" value="{{ filters.name }}" placeholder='Nom...'>
                    
                </th>
                <th>
                    <select form='cards_table_filters' id="type" name="type" class="form-control">
                        <option value=''></option>
                        {% for card_type in card_types %}
                            <option value='{{card_type}}' {% if (card_type==filters.type) %}selected{% endif %}>{{card_type}}</option>
                        {% endfor %}
                    </select>
                </th>
                <th colspan='2'>
                    <button form='cards_table_filters' type="submit" class="btn btn-primary">Filtrer</button>
                </th>
            </tr>
            <tr>
                <th>Carte</th>
                <th>Type</th>
                <th>Effet</th>
                <th>Image</th>
            </tr>
        </thead>
        <tbody>
            {% for card in cards %}
                <tr>
                    <td>{{ card.name }}</td>
                    <td>{{ card.type }}</td>
                    <td>
                        {% if (card.itemEffect is not empty) %}
                            {{ card.itemEffect }}
                        {% else %}
                            {% if (card.type in ['Monstre','Lieu','Suspect']) %}
                                Carte piste : doit être utilisée pour résoudre le mystère.
                            {% elseif (card.type == 'Destination') %}
                                Point sur la carte vers lequel se déplacer pour obtenir un nouvel indice.
                            {% endif %}
                        {% endif %}
                    </td>
                    {# <td><img src="{{ asset('uploads/cards/' ~ card.image) }}" alt="{{ card.name }}" width="100"></td> --- TODO --- #}
                    <td>Picture</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <script>
        document.querySelectorAll("#cards_table_filters_tr input, #cards_table_filters_tr select").forEach(function(field, findex){
            console.log("a");
            field.addEventListener('change', function(){
                console.log("b");
                document.querySelector("#cards_table_filters").requestSubmit();
            });
        });

    </script>

{% endblock %}
