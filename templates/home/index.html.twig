{% extends 'base.html.twig' %}

{% block body %}
    <h1>Accueil</h1>

    {% if app.user %}
        <p>Bonjour <strong>{{ app.user.username }}</strong></p>
        <p><a href="{{ path('app_profile') }}">Voir mon profil</a></p>
    {% else %}
        <p>Page réservée aux membres.</p>
        <p><a href="{{ path('app_register') }}">Créer un compte</a> ou <a href="{{ path('app_login') }}">se connecter</a></p>
    {% endif %}
{% endblock %}